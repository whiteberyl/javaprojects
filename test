public class Test {

    public static void main(String[] args) {

        // Create r1.
        //
        // Width = 5
        // Height = 4
        //
        // Area = 5 * 4 = 20
        ComparableRectangle r1 =
            new ComparableRectangle(5, 4);


        // Create r2.
        //
        // Width = 2
        // Height = 3
        //
        // Area = 2 * 3 = 6
        ComparableRectangle r2 =
            new ComparableRectangle(2, 3);


        // getArea() originally comes from Rectangle.
        //
        // ComparableRectangle inherits it because
        // ComparableRectangle extends Rectangle.
        System.out.println(
            "r1 area = " + r1.getArea()
        );


        System.out.println(
            "r2 area = " + r2.getArea()
        );


        // Compare r1 with r2.
        //
        // Inside compareTo:
        //
        // this = r1
        // r = r2
        //
        // 20 > 6
        //
        // Therefore compareTo returns 1.
        System.out.println(
            "Comparison = " + r1.compareTo(r2)
        );
    }
}


// ABSTRACT SUPERCLASS
//
// This class provides the general idea
// of a geometric object.
//
// We do not want to create generic
// GeometricObject objects directly.
abstract class GeometricObject {


    // Abstract method.
    //
    // There is NO body.
    //
    // Every concrete subclass must provide
    // an implementation of getArea().
    public abstract double getArea();
}


// Rectangle inherits from GeometricObject.
//
// This creates an IS-A relationship:
//
// Rectangle IS-A GeometricObject.
class Rectangle extends GeometricObject {


    // Private Rectangle data fields.
    private double width;
    private double height;


    // Rectangle constructor.
    public Rectangle(
        double width,
        double height
    ) {

        // Store the parameter values
        // inside this Rectangle object.
        this.width = width;
        this.height = height;
    }


    // GeometricObject required us to
    // provide getArea().
    //
    // Rectangle's area formula is:
    //
    // width * height
    public double getArea() {

        return width * height;
    }
}


// ComparableRectangle inherits from Rectangle.
//
// Therefore:
//
// ComparableRectangle IS-A Rectangle
//
// Since Rectangle IS-A GeometricObject:
//
// ComparableRectangle is ALSO
// a GeometricObject.
//
// It ALSO implements Comparable,
// allowing two ComparableRectangle
// objects to be compared.
class ComparableRectangle
    extends Rectangle
    implements Comparable<ComparableRectangle> {


    // Constructor.
    public ComparableRectangle(
        double width,
        double height
    ) {


        // Rectangle already has a constructor
        // that knows how to store width and height.
        //
        // super means the parent/superclass.
        //
        // The superclass here is Rectangle.
        //
        // Therefore:
        //
        // super(width, height)
        //
        // calls:
        //
        // Rectangle(width, height)
        super(width, height);
    }


    // Comparable requires compareTo().
    //
    // The parameter r represents another
    // ComparableRectangle.
    public int compareTo(
        ComparableRectangle r
    ) {


        // Example:
        //
        // r1.compareTo(r2)
        //
        // this = r1
        // r    = r2
        //
        // this.getArea() = r1's area
        // r.getArea()    = r2's area


        if (this.getArea() > r.getArea()) {

            // Positive:
            //
            // THIS object is larger.
            return 1;
        }


        else if (
            this.getArea() < r.getArea()
        ) {

            // Negative:
            //
            // THIS object is smaller.
            return -1;
        }


        else {

            // Zero:
            //
            // Both objects are considered equal
            // according to our comparison.
            return 0;
        }
    }
}

        //
        // We are passing the numbers array
        // into the method.
        printArray(numbers);
    }


    // This method RECEIVES a 2D integer array.
    //
    // int[][] tells Java the parameter
    // must refer to a 2D int array.
    //
    // array is the parameter name.
    public static void printArray(int[][] array) {


        // Loop through every row.
        for (
            int row = 0;
            row < array.length;
            row++
        ) {


            // Loop through every column
            // inside the current row.
            for (
                int column = 0;
                column < array[row].length;
                column++
            ) {


                // Print the current value.
                System.out.print(
                    array[row][column] + " "
                );
            }


            // Start a new line after each row.
            System.out.println();
        }
    }
}

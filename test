# 8. Arrays — Sort, Search, toString

```java
// We import Arrays because methods such as
// Arrays.sort(), Arrays.toString(), and
// Arrays.binarySearch() belong to java.util.Arrays.
import java.util.Arrays;


public class ArrayExample {

    public static void main(String[] args) {

        // Create an integer array containing 5 values.
        //
        // Indexes:
        //
        //        0   1   2   3   4
        //
        //       [50][10][40][20][30]
        int[] numbers = {50, 10, 40, 20, 30};


        // Arrays.toString() converts the array
        // into an easy-to-read String.
        System.out.println(
            "Original: " + Arrays.toString(numbers)
        );


        // Sort the array from smallest to largest.
        //
        // BEFORE:
        //
        // [50, 10, 40, 20, 30]
        //
        // AFTER:
        //
        // [10, 20, 30, 40, 50]
        Arrays.sort(numbers);


        System.out.println(
            "Sorted: " + Arrays.toString(numbers)
        );


        // binarySearch() searches for a value.
        //
        // IMPORTANT:
        //
        // The array should be sorted before
        // using binarySearch().
        //
        // Our sorted array:
        //
        // index:   0   1   2   3   4
        //
        // value: [10][20][30][40][50]
        //
        // Therefore 30 is located at index 2.
        int index =
            Arrays.binarySearch(numbers, 30);


        System.out.println(
            "30 is at index: " + index
        );


        // .length tells us how many elements
        // the array can hold.
        //
        // There are 5 elements.
        System.out.println(
            "Array length: " + numbers.length
        );


        // IMPORTANT:
        //
        // length = 5
        //
        // indexes = 0, 1, 2, 3, 4
        //
        // Therefore:
        //
        // last index = length - 1
        //
        //            = 5 - 1
        //
        //            = 4
        System.out.println(
            "Last index: " + (numbers.length - 1)
        );
    }
}
```

